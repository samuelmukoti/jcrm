{
  "name": "jcrm-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "package": "npm run build && ./mvnw -B clean package",
    "test": "./mvnw -B test && npm run build && npm --prefix frontend run test:e2e",
    "test:api": "./mvnw -B test",
    "test:browser": "npm --prefix frontend run test:e2e --",
    "screenshots": "node scripts/capture.mjs",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
